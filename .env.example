# ── OJAS backend configuration ──────────────────────────
# Copy to .env and fill in. Never commit real keys.

# Port the site + API run on
PORT=8787

# Razorpay (dashboard.razorpay.com → Settings → API Keys)
# Test keys work immediately in test mode (payments are simulated).
# Live keys require account verification; money settles to the bank
# account registered there — use the HDFC account behind 7042347171@hdfc.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Business (Meta Cloud API) — optional
# From developers.facebook.com → your app → WhatsApp → API Setup
# (phone_number_id) and a long-lived system-user token (WA_ACCESS_TOKEN).
# Sandbox can only message your own test number; a verified business
# number + approved template pushes to any patient.
CLINIC_WHATSAPP=917042347171
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Token needed to view the booking log: GET /api/orders?token=...
ADMIN_TOKEN=dev-secret
